# This target deliberately does not discover Python, Torch, or Warp.
enable_language(CXX)
include(GNUInstallDirs)
include(CMakePackageConfigHelpers)
option(WARPSPHCORE_STANDALONE_OPENMP "Parallel CPU rows using OpenMP" ON)
option(WARPSPHCORE_STANDALONE_TESTS "Build standalone C++ correctness tests" ON)
set(sph_package "${CMAKE_CURRENT_SOURCE_DIR}/src/warpSPHCore")
set(sph_headers "${sph_package}/native/csrc")
add_library(warpsph_core SHARED "${sph_headers}/runtime/api.cpp" "${sph_headers}/runtime/cpu.cpp")
add_library(warpSPHCore::core ALIAS warpsph_core)
target_compile_features(warpsph_core PUBLIC cxx_std_17)
target_include_directories(warpsph_core PUBLIC
  $<BUILD_INTERFACE:${sph_headers}>
  $<INSTALL_INTERFACE:${CMAKE_INSTALL_INCLUDEDIR}/warpSPHCore>)
target_include_directories(warpsph_core PRIVATE "${sph_package}")
target_compile_definitions(warpsph_core PRIVATE SPH_NATIVE_BUILDING_LIBRARY)
set_target_properties(warpsph_core PROPERTIES EXPORT_NAME core VERSION 0.6.3 SOVERSION 0
  CXX_VISIBILITY_PRESET hidden CUDA_VISIBILITY_PRESET hidden HIP_VISIBILITY_PRESET hidden
  VISIBILITY_INLINES_HIDDEN YES)
if(WARPSPHCORE_STANDALONE_OPENMP)
  find_package(OpenMP REQUIRED COMPONENTS CXX)
  target_link_libraries(warpsph_core PRIVATE OpenMP::OpenMP_CXX)
endif()
if(NOT WARPSPHCORE_CPU_ARCH STREQUAL "portable")
  if(CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    target_compile_options(warpsph_core PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-mcpu=${WARPSPHCORE_CPU_ARCH}>)
  else()
    target_compile_options(warpsph_core PRIVATE $<$<COMPILE_LANGUAGE:CXX>:-march=${WARPSPHCORE_CPU_ARCH}>)
  endif()
endif()
if(WARPSPHCORE_NATIVE_BACKEND STREQUAL "cuda")
  if(NOT CMAKE_CUDA_ARCHITECTURES)
    message(FATAL_ERROR "Set CMAKE_CUDA_ARCHITECTURES explicitly")
  endif()
  enable_language(CUDA)
  find_package(CUDAToolkit REQUIRED)
  target_sources(warpsph_core PRIVATE "${sph_headers}/runtime/gpu.cu" "${sph_headers}/runtime/scan_gpu.cu")
  target_compile_features(warpsph_core PRIVATE cuda_std_17)
  target_compile_definitions(warpsph_core PRIVATE SPH_NATIVE_HAS_GPU SPH_NATIVE_CUDA)
  target_link_libraries(warpsph_core PRIVATE CUDA::cudart)
elseif(WARPSPHCORE_NATIVE_BACKEND STREQUAL "hip")
  if(NOT CMAKE_HIP_ARCHITECTURES)
    message(FATAL_ERROR "Set CMAKE_HIP_ARCHITECTURES explicitly")
  endif()
  enable_language(HIP)
  target_sources(warpsph_core PRIVATE "${sph_headers}/runtime/gpu.cu" "${sph_headers}/runtime/scan_gpu.cu")
  set_source_files_properties("${sph_headers}/runtime/gpu.cu" "${sph_headers}/runtime/scan_gpu.cu" PROPERTIES LANGUAGE HIP)
  set_target_properties(warpsph_core PROPERTIES HIP_STANDARD 17 HIP_STANDARD_REQUIRED YES)
  target_compile_definitions(warpsph_core PRIVATE SPH_NATIVE_HAS_GPU SPH_NATIVE_HIP)
elseif(NOT WARPSPHCORE_NATIVE_BACKEND STREQUAL "cpu")
  message(FATAL_ERROR "WARPSPHCORE_NATIVE_BACKEND must be cpu, cuda or hip")
endif()
install(TARGETS warpsph_core EXPORT warpSPHCoreTargets LIBRARY DESTINATION ${CMAKE_INSTALL_LIBDIR}
  RUNTIME DESTINATION ${CMAKE_INSTALL_BINDIR} ARCHIVE DESTINATION ${CMAKE_INSTALL_LIBDIR})
install(FILES "${sph_headers}/api.h" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/warpSPHCore)
install(FILES "${sph_headers}/config.h" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/warpSPHCore)
foreach(folder dataTypes math util kernels)
  install(DIRECTORY "${sph_headers}/${folder}/" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/warpSPHCore/${folder} FILES_MATCHING PATTERN "*.h")
endforeach()
foreach(header scan.h atomic.h traversal.h fieldTraversal.h adjointTraversal.h)
  install(FILES "${sph_headers}/execution/${header}" DESTINATION ${CMAKE_INSTALL_INCLUDEDIR}/warpSPHCore/execution)
endforeach()
install(EXPORT warpSPHCoreTargets NAMESPACE warpSPHCore:: DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/warpSPHCore)
configure_package_config_file("${CMAKE_CURRENT_SOURCE_DIR}/cmake/warpSPHCoreConfig.cmake.in"
  "${CMAKE_CURRENT_BINARY_DIR}/warpSPHCoreConfig.cmake" INSTALL_DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/warpSPHCore)
write_basic_package_version_file("${CMAKE_CURRENT_BINARY_DIR}/warpSPHCoreConfigVersion.cmake" VERSION 0.6.3 COMPATIBILITY SameMajorVersion)
install(FILES "${CMAKE_CURRENT_BINARY_DIR}/warpSPHCoreConfig.cmake" "${CMAKE_CURRENT_BINARY_DIR}/warpSPHCoreConfigVersion.cmake"
  DESTINATION ${CMAKE_INSTALL_LIBDIR}/cmake/warpSPHCore)
if(WARPSPHCORE_STANDALONE_TESTS)
  enable_testing()
  add_executable(native_standalone scripts/examples/standalone/main.cpp)
  target_link_libraries(native_standalone PRIVATE warpSPHCore::core)
  add_test(NAME native_standalone COMMAND native_standalone)
  set_tests_properties(native_standalone PROPERTIES LABELS "cpu;example")
  add_executable(native_standalone_checks tests/native/cpp/standalone_smoke.cpp)
  target_link_libraries(native_standalone_checks PRIVATE warpSPHCore::core)
  add_test(NAME native_standalone_checks COMMAND native_standalone_checks)
  set_tests_properties(native_standalone_checks PROPERTIES LABELS "cpu;native")
  add_executable(native_scan_checks tests/native/cpp/scan.cpp)
  target_link_libraries(native_scan_checks PRIVATE warpSPHCore::core)
  add_test(NAME native_scan_checks COMMAND native_scan_checks)
  set_tests_properties(native_scan_checks PROPERTIES LABELS "cpu;native")
  if(NOT WARPSPHCORE_NATIVE_BACKEND STREQUAL "cpu")
    add_executable(native_standalone_gpu tests/native/cpp/standalone_gpu.cu)
    target_link_libraries(native_standalone_gpu PRIVATE warpSPHCore::core)
    if(WARPSPHCORE_NATIVE_BACKEND STREQUAL "cuda")
      target_link_libraries(native_standalone_gpu PRIVATE CUDA::cudart)
      set_property(TARGET native_standalone_gpu APPEND PROPERTY BUILD_RPATH "$<TARGET_FILE_DIR:CUDA::cudart>")
      target_compile_features(native_standalone_gpu PRIVATE cuda_std_17)
    else()
      set_source_files_properties(tests/native/cpp/standalone_gpu.cu PROPERTIES LANGUAGE HIP)
      set_target_properties(native_standalone_gpu PROPERTIES HIP_STANDARD 17)
      target_compile_definitions(native_standalone_gpu PRIVATE SPH_NATIVE_HIP)
    endif()
    add_test(NAME native_standalone_gpu COMMAND native_standalone_gpu)
    set_tests_properties(native_standalone_gpu PROPERTIES SKIP_RETURN_CODE 77 LABELS "${WARPSPHCORE_NATIVE_BACKEND};native")
  endif()
  # A thin test-only C boundary lets Python compare arbitrary buffers with the
  # independent numerical oracles. It is not installed or part of the public API.
  add_library(native_standalone_test SHARED tests/native/cpp/standalone_bridge.cpp)
  target_link_libraries(native_standalone_test PRIVATE warpSPHCore::core)
endif()
